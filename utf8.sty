% Unicode characters typed directly into a pdfLaTeX document, in text or in
% maths, are set as the corresponding LaTeX symbols. Characters set as AMS
% symbols need amssymb, or a font package that provides them such as
% newtxmath; ⟦ and ⟧ need stmaryrd, and ∎ needs amsthm. Greek letters in
% typewriter text need upright Greek, \upalpha and so on, as newtxmath and
% upgreek provide.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{utf8}[2026/11/12 Unicode characters in text and maths]
\RequirePackage{esint}
\RequirePackage{graphicx}

% A binary operator made from a math glyph scaled by a factor; it stays on
% the math axis and follows the current math style.
\newcommand{\scaledbin}[2]{\mathbin{\mathpalette{\scaledbin@{#1}}{#2}}}
\newcommand{\scaledbin@}[3]{\vcenter{\hbox{\scalebox{#1}{$\m@th#2#3$}}}}

% A relation symbol stretched horizontally by a factor; it follows the
% current math style.
\newcommand{\widerel}[2]{\mathrel{\mathpalette{\widerel@{#1}}{#2}}}
\newcommand{\widerel@}[3]{\hbox{\scalebox{#1}[1]{$\m@th#2#3$}}}

% Greek and double-struck letters and × are maths, but in the typewriter face
% each takes the width of one character, so that code keeps its columns:
% Greek letters stand upright, double-struck letters are DSSerif's, and × is
% the typewriter face's own. A letter wider than that is centred on its
% column, or squeezed to it with the package option `condensed`.
\newcommand\utf@tt[2]{\ifmmode#2\else\utf@iftt{#1}{$\m@th#2$}\fi}
\newcommand\utf@iftt{%
  \edef\utf@family{\f@family}\edef\utf@ttfamily{\ttdefault}%
  \ifx\utf@family\utf@ttfamily
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi}
\newcommand\utf@column[2]{\utf@tt{\utf@code{#2}}{#1}}
\newcommand\utf@centred[1]{\makebox[\fontcharwd\font`x]{$\m@th#1$}}
\newcommand\utf@condensed[1]{%
  \sbox\z@{$\m@th#1$}%
  \ifdim\wd\z@>\fontcharwd\font`x
    \makebox[\fontcharwd\font`x]{\resizebox{\fontcharwd\font`x}{\height}{\usebox\z@}}%
  \else
    \makebox[\fontcharwd\font`x]{\usebox\z@}%
  \fi}
\DeclareOption{centred}{\let\utf@code\utf@centred}
\DeclareOption{condensed}{\let\utf@code\utf@condensed}
\ExecuteOptions{centred}
\ProcessOptions\relax
\DeclareFontFamily{U}{utfdsserif}{\skewchar\font=45}
\DeclareFontShape{U}{utfdsserif}{m}{n}{<-> DSSerif}{}
\newcommand\utf@ds[1]{\hbox{\usefont{U}{utfdsserif}{m}{n}#1}}

% Italic double-struck letters, which none of the fonts draw, are the
% upright ones slanted, with room for the slant before and after.
\newcommand\utf@slanted[1]{\mathord{\mathpalette\utf@slanted@{#1}}}
\newcommand\utf@slanted@[2]{\sbox\z@{$\m@th#1#2$}\kern.2\dp\z@\hskip\wd\z@
  \pdfsave\pdfsetmatrix{1 0 .2 1}\llap{\usebox\z@}\pdfrestore\kern.2\ht\z@}

